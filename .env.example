# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Application ID from the General Information page
CLIENT_ID=your_application_id_here

# Your server's ID (right-click server -> Copy Server ID, needs Developer Mode on)
GUILD_ID=your_server_id_here

# Your own Discord user ID. The dashboard attributes its actions to you, so the
# audit trail names a person rather than the bot.
USER_ID=your_user_id_here

# Dashboard sign-in token. Leave this out and a fresh one is generated on every
# boot and printed to the console. Set it to keep one across restarts.
# WEB_TOKEN=a_long_random_string

# --- Minecraft server database (Tempest Suite plugin) ------------------------
# All five come from your host's panel, Databases tab. They live here rather than
# in config.js because config.js is committed to git, and a database that accepts
# connections from anywhere makes the host and username half of a credential.
#
# Quote the password: panel passwords contain characters like + ^ $ and #, and an
# unquoted # starts a comment, which silently truncates it.
TEMPEST_DB_HOST=sql-01.example.com
TEMPEST_DB_PORT=3306
TEMPEST_DB_USER=u000_xxxxxxxx
TEMPEST_DB_NAME=s000_yourdb
TEMPEST_DB_PASSWORD='paste-from-the-panel'
