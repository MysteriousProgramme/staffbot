# systemd unit for Staffbot.
#
# Install with deploy/install.sh, or by hand:
#   sudo cp deploy/staffbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now staffbot
#
# Replace __USER__ and __DIR__ if you are doing it by hand.

[Unit]
Description=Staffbot - Discord staff management
Documentation=https://github.com/MysteriousProgramme/staffbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__

# .env is KEY=VALUE, which is exactly systemd's EnvironmentFile format.
EnvironmentFile=__DIR__/.env

ExecStart=/usr/bin/node src/index.js

# Discord connections drop. Always come back, but back off so a config error
# doesn't turn into a restart loop hammering the API.
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=staffbot

# The bot only needs its own directory. Everything else stays read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__DIR__

[Install]
WantedBy=multi-user.target
